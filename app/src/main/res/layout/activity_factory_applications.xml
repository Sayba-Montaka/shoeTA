<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_header">
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/glassCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_overlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <!-- Header -->
    <LinearLayout
        android:id="@+id/below"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="আবেদনকারীগণ / Applicants"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>


    <!-- Applicant list -->
    <androidx.recyclerview.widget.RecyclerView
        android:layout_below="@+id/below"
        android:id="@+id/recyclerApplicants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"/>
    <TextView
        android:layout_alignParentBottom="true"
        android:id="@+id/appoinmentHover"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="অ্যাপয়েন্টমেন্ট দিন"
        android:textSize="20dp"
        android:textAlignment="center"
        android:paddingTop="10dp"
        android:textColor="@color/white"
        android:background="@drawable/bg_gradient_header"
        android:visibility="gone"
        />
    </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</RelativeLayout>
