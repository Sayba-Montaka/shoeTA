<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="18dp"
    android:layout_marginBottom="12dp"
    android:elevation="1dp">

    <!-- Top: job title + status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView
            android:id="@+id/tvAppJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Job Title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/tvAppStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="11sp"
            android:textColor="@color/status_warning"
            android:background="@drawable/bg_badge_warning"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Company + location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp">
            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_purple"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="🏭"
                android:textSize="15sp" android:gravity="center"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:id="@+id/tvAppCompany"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Company Name" android:textSize="14sp"
                android:textColor="@color/text_primary"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📍 " android:textSize="11sp"/>
                <TextView android:id="@+id/tvAppLocation"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Location" android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/tvAppSalary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="৳0/মাস" android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/text_accent"/>
            <TextView android:id="@+id/tvAppDate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Jan 1" android:textSize="11sp"
                android:textColor="@color/text_hint"/>
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" android:layout_marginBottom="10dp"/>

    <!-- Tag chips -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvAppShift"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Day"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="@color/tag_fulltime_text" android:background="@drawable/bg_tag_purple"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvAppType"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Full Time"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="@color/chip_idle_text"
            android:background="@drawable/bg_chip_idle"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvAppAppointment"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="📅 নির্ধারিত হয়নি"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="@color/status_info"
            android:background="@drawable/bg_chip_idle"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>