<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_header"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/glassCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_overlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="24dp"
            android:background="@drawable/bg_gradient_header">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pirbari"
                android:textSize="12sp"
                android:textColor="#DDDAF8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কারখানা নিবন্ধন
Factory Registration"
                android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        </LinearLayout>

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/whole2"
    android:text="নিবন্ধন সম্পন্ন! অনুমোদনের অপেক্ষা করুন"
    android:background="#c37b5a"
    android:textSize="30sp"
    android:textStyle="bold|italic"
    android:padding="30dp"
    android:visibility="gone"
    />
        <!-- Form -->
        <LinearLayout
            android:id="@+id/wholeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_header"
            android:padding="24dp"
            android:layout_marginTop="-16dp">

            <!-- Company Name -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="কারখানার নাম / Company Name" android:textSize="13sp"
                android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etCompanyName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="কারখানার নাম লিখুন"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="18dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কারখানার  মালিকের নাম / Company Proprietor Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etProprietorName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="কারখানার মালিকের নাম লিখুন"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp"
                android:layout_marginBottom="18dp"/>

            <!-- Phone -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ফোন নম্বর / Phone" android:textSize="13sp"
                android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etPhone"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:hint="01XXXXXXXXX" android:inputType="phone"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_hint"
                android:textSize="15sp" android:layout_marginBottom="18dp"/>

            <!-- Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="পাসওয়ার্ড / Password" android:textSize="13sp"
                android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etPassword"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:hint="••••••••" android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_hint"
                android:textSize="15sp" android:layout_marginBottom="18dp"/>

            <!-- Location -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ঠিকানা / Address" android:textSize="13sp"
                android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etLocation"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:hint="যেমন: মিরপুর, ঢাকা" android:background="@drawable/bg_input"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_hint"
                android:textSize="15sp" android:layout_marginBottom="28dp"/>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <Button android:id="@+id/btnRegister"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="নিবন্ধন করুন / Register"
                android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/text_on_accent"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="16dp"/>

            <TextView android:id="@+id/tvLoginLink"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ইতিমধ্যে অ্যাকাউন্ট আছে? লগইন করুন"
                android:textSize="13sp" android:textColor="@color/text_accent"
                android:layout_gravity="center_horizontal" android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
    </LinearLayout>
</ScrollView>